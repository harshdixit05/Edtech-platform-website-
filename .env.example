# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Database --------------------------------------------------------------
# Postgres connection string. Neon, Supabase and Railway all give you one.
# Must include sslmode=require for hosted providers.
DATABASE_URL="postgresql://user:password@host:5432/intellimindz?sslmode=require"

# --- Secrets ---------------------------------------------------------------
# Used to HMAC rate-limit keys so the table holds no raw emails or IPs.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Email -----------------------------------------------------------------
# Without a key, verification and reset emails are written to the server log
# instead of being sent — fine locally, never acceptable in production.
RESEND_API_KEY=""
EMAIL_FROM="Intellimindz Foundation <noreply@intellimindz.in>"

# --- App -------------------------------------------------------------------
# Absolute origin used to build links inside emails. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Learning advisor ------------------------------------------------------
# The Python advisor service (see the intellimindz-advisor repo). The browser
# never talks to it: requests go through /api/advisor on this server, so the
# URL and token stay off the client and no CORS grant is needed for a public
# origin. Leave either blank and the chat widget simply does not render.
ADVISOR_API_URL="http://127.0.0.1:8000"
# Must match ADVISOR_API_TOKEN in the advisor's own .env.local. It is also the
# key used to HMAC a visitor's address into the opaque id the advisor
# rate-limits by, so the advisor never handles an IP.
ADVISOR_API_TOKEN=""
